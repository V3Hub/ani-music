#!/usr/bin/env sh
# post-commit: 自动 bump 版本号 + changelog
# 执行：node scripts/release.mjs --from-git-message --auto-commit
# 用 sh 包装而不是直接 node，是为了让 Git 在 Windows 上也能识别 shebang 并执行

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# 允许临时跳过：HUSKY=0 git commit ...
if [ "${HUSKY:-}" = "0" ]; then
  echo "  (husky disabled via HUSKY=0)"
  exit 0
fi

cd "$ROOT"
exec node scripts/release.mjs --from-git-message --auto-commit
