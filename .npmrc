# ===== pnpm 运行时配置（简单开关放这里） =====

# 严格执行 package.json 中的 engines.node / engines.pnpm 约束
engine-strict=true

# Artifactory 私服不保留官方 provenance 签名，
# pnpm 12 默认 trustPolicy=no-downgrade 会把所有包判成"可能劫持"，
# 关闭仅影响本项目的安装过程
trust-policy=off

# Windows 上用内置 shell 模拟器跑 postinstall，避免依赖 Git Bash
shell-emulator=true
