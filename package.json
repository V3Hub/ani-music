{
  "name": "ani-music",
  "version": "0.1.12",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @ani-music/web dev",
    "build": "pnpm --filter @ani-music/web build",
    "build:worker": "pnpm --filter @ani-music/worker build",
    "preview": "pnpm --filter @ani-music/web preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "release": "node apps/web/scripts/release.mjs",
    "release:minor": "node apps/web/scripts/release.mjs minor",
    "release:major": "node apps/web/scripts/release.mjs major"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/node": "^22.7.5",
    "eslint": "^10.14.0",
    "eslint-plugin-format": "^2.0.1",
    "prettier": "^3.9.10",
    "typescript": "~5.6.2"
  }
}
